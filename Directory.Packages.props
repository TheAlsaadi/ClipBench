<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    Every package needs an entry in docs/adr (why, maintainer, license,
    alternatives) and the owner's approval before it is added here.
    Versions below were checked against nuget.org on 2026-10-13.
  -->
  <ItemGroup Label="Test stack (ADR 0006)">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.4" />
  </ItemGroup>

  <ItemGroup Label="Storage (ADR 0008)">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Win32 interop (ADR 0010)">
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.360" />
  </ItemGroup>

  <ItemGroup Label="UI platform (ADR 0001)">
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup Label="Application framework (ADR 0012)">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
  </ItemGroup>

</Project>
