<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- The generated Win32 declarations use pointers (ADR 0010). Only this project allows unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The notification-area structure exists only per CPU architecture. x64 and ARM64 share the 64-bit layout, so one build serves both. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipBench.Core\ClipBench.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build time only: PrivateAssets keeps the generator and its metadata packages (ADR 0010) from reaching other projects. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- A second text recognizer for code, paths and symbols (ADR 0019). x64 only: the package has no ARM64 build. -->
    <PackageReference Include="TesseractOCR" />
  </ItemGroup>

  <ItemGroup>
    <!-- The English model, pinned by its SHA-256 in tests/ClipBench.Platform.Windows.IntegrationTests (ADR 0019). -->
    <Content Include="../../third_party/tessdata/eng.traineddata" Link="tessdata\eng.traineddata" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The package copies native files for x86 as well, and its own tesseract.exe is never started. Neither is shipped. -->
  <Target Name="DropUnusedTesseractFiles" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_UnusedTesseract Include="@(None)" Condition="$([System.String]::new('%(None.Link)').StartsWith('x86'))" />
      <_UnusedTesseract Include="@(None)" Condition="$([System.String]::new('%(None.Filename)%(None.Extension)').Equals('tesseract.exe'))" />
      <None Remove="@(_UnusedTesseract)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="ClipBench.Platform.Windows.IntegrationTests" />
  </ItemGroup>

</Project>
