<Window
    x:Class="ClipBench.App.NoticeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClipBench">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="TitleText"
            AutomationProperties.AutomationId="NoticeTitle"
            Style="{StaticResource SubtitleTextBlockStyle}"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="MessageText"
            Grid.Row="1"
            AutomationProperties.AutomationId="NoticeMessage"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="SecondaryButton"
                AutomationProperties.AutomationId="NoticeSecondary"
                Click="OnSecondaryClick" />
            <Button
                x:Name="PrimaryButton"
                AutomationProperties.AutomationId="NoticePrimary"
                Click="OnPrimaryClick"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
