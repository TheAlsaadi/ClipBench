<Window
    x:Class="ClipBench.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClipBench.App"
    xmlns:prefs="using:ClipBench.Presentation.Preferences"
    xmlns:snippets="using:ClipBench.Presentation.Snippets"
    Title="ClipBench settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Frame"
        Padding="16"
        ColumnSpacing="16"
        PreviewKeyDown="Frame_PreviewKeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView
            x:Name="SectionList"
            Grid.Column="0"
            AutomationProperties.AutomationId="SettingsSections"
            AutomationProperties.Name="Settings sections"
            ItemsSource="{x:Bind local:SettingsWindow.SectionItems}"
            SelectionChanged="SectionList_SelectionChanged"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="prefs:SettingsSectionItem">
                    <TextBlock
                        Padding="0,6"
                        AutomationProperties.AutomationId="{x:Bind Title}"
                        AutomationProperties.Name="{x:Bind Title}"
                        Text="{x:Bind Title}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Column="1">

            <!-- General -->
            <ScrollViewer x:Name="GeneralPanel" AutomationProperties.AutomationId="GeneralPanel">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="General" />

                    <Border
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{x:Bind ViewModel.General.ShowFirstRun, Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Welcome to ClipBench" />
                            <TextBlock
                                Text="ClipBench keeps your clipboard history on this PC, encrypted, and never connects to the internet. Should it start when you sign in to Windows? You can change this any time."
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="FirstRunYes"
                                    Command="{x:Bind ViewModel.General.AcceptFirstRunCommand}"
                                    Content="Yes, start with Windows"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    AutomationProperties.AutomationId="FirstRunNo"
                                    Command="{x:Bind ViewModel.General.DeclineFirstRunCommand}"
                                    Content="No thanks" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ToggleSwitch
                        AutomationProperties.AutomationId="StartWithWindowsSwitch"
                        Header="Start ClipBench when I sign in to Windows"
                        IsEnabled="{x:Bind ViewModel.General.CanStartWithWindows, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.General.StartWithWindows, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                    <TextBlock
                        AutomationProperties.AutomationId="GeneralError"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.General.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- Shortcuts -->
            <ScrollViewer
                x:Name="HotkeysPanel"
                AutomationProperties.AutomationId="HotkeysPanel"
                Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Shortcuts" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Click a box and press the keys you want. A shortcut needs Ctrl, Alt or Win, unless it is a function key."
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="PopupHotkeyBox"
                            AutomationProperties.AutomationId="PopupHotkeyBox"
                            AutomationProperties.Name="Open the popup"
                            Header="Open the popup"
                            IsReadOnly="True"
                            PreviewKeyDown="PopupHotkeyBox_PreviewKeyDown"
                            Text="{x:Bind ViewModel.Hotkeys.PopupHotkey, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="ResetPopupHotkey"
                            Command="{x:Bind ViewModel.Hotkeys.ResetPopupCommand}"
                            Content="Reset" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="CollectHotkeyBox"
                            AutomationProperties.AutomationId="CollectHotkeyBox"
                            AutomationProperties.Name="Start and finish collecting"
                            Header="Start and finish collecting"
                            IsReadOnly="True"
                            PreviewKeyDown="CollectHotkeyBox_PreviewKeyDown"
                            Text="{x:Bind ViewModel.Hotkeys.CollectHotkey, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="ResetCollectHotkey"
                            Command="{x:Bind ViewModel.Hotkeys.ResetCollectCommand}"
                            Content="Reset" />
                    </Grid>

                    <TextBlock
                        AutomationProperties.AutomationId="HotkeysError"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.Hotkeys.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- History -->
            <ScrollViewer
                x:Name="HistoryPanel"
                AutomationProperties.AutomationId="HistoryPanel"
                Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="History" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Pinned clips are never removed. Older clips go first when a limit is reached."
                        TextWrapping="Wrap" />
                    <NumberBox
                        x:Name="MaxCountBox"
                        Width="260"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="MaxCountBox"
                        Header="Most clips to keep"
                        SmallChange="10"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="MaxCountBox_ValueChanged" />
                    <NumberBox
                        x:Name="MaxAgeBox"
                        Width="260"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="MaxAgeBox"
                        Header="Days to keep a clip"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="MaxAgeBox_ValueChanged" />
                    <NumberBox
                        x:Name="MaxMegabytesBox"
                        Width="260"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="MaxMegabytesBox"
                        Header="Most megabytes of clips to keep"
                        SmallChange="16"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="MaxMegabytesBox_ValueChanged" />
                    <TextBlock
                        AutomationProperties.AutomationId="HistoryError"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.History.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- Privacy -->
            <ScrollViewer
                x:Name="PrivacyPanel"
                AutomationProperties.AutomationId="PrivacyPanel"
                Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Privacy" />

                    <ToggleSwitch
                        AutomationProperties.AutomationId="IncognitoSwitch"
                        Header="Incognito: record nothing until I turn it off"
                        IsOn="{x:Bind ViewModel.Privacy.IsIncognito, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />

                    <ToggleSwitch
                        AutomationProperties.AutomationId="MaskSensitiveSwitch"
                        Header="Hide passwords, keys, tokens and card numbers"
                        IsOn="{x:Bind ViewModel.Privacy.MaskSensitive, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />

                    <NumberBox
                        x:Name="SensitiveExpiryBox"
                        Width="260"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="SensitiveExpiryBox"
                        Header="Seconds to keep a clip that looks like a secret"
                        SmallChange="15"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="SensitiveExpiryBox_ValueChanged" />

                    <ToggleSwitch
                        AutomationProperties.AutomationId="HideFromCaptureSwitch"
                        Header="Keep ClipBench's windows out of screenshots and screen sharing"
                        IsOn="{x:Bind ViewModel.Privacy.HideFromScreenCapture, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Programs that are never recorded" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Anything copied from these programs is ignored. Password managers are listed by default."
                            TextWrapping="Wrap" />
                        <ListView
                            MaxHeight="220"
                            AutomationProperties.AutomationId="ExcludedPrograms"
                            AutomationProperties.Name="Programs that are never recorded"
                            ItemsSource="{x:Bind ViewModel.Privacy.ExcludedPrograms, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Bind}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.Name="Remove"
                                            Click="RemoveProgram_Click"
                                            Content="Remove"
                                            Tag="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                AutomationProperties.AutomationId="NewProgramBox"
                                AutomationProperties.Name="Program to add"
                                KeyDown="NewProgramBox_KeyDown"
                                MaxLength="100"
                                PlaceholderText="Program name, for example notepad.exe"
                                Text="{x:Bind ViewModel.Privacy.NewProgram, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.AutomationId="AddProgramButton"
                                Command="{x:Bind ViewModel.Privacy.AddProgramCommand}"
                                Content="Add" />
                        </Grid>
                        <Button
                            AutomationProperties.AutomationId="RestoreExclusionsButton"
                            Command="{x:Bind ViewModel.Privacy.RestoreDefaultExclusionsCommand}"
                            Content="Restore the default list" />
                    </StackPanel>

                    <TextBlock
                        AutomationProperties.AutomationId="PrivacyError"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.Privacy.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Delete everything" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Deletes every clip, pinned clip, board and snippet, and scrubs them from disk. This cannot be undone."
                            TextWrapping="Wrap" />
                        <Button
                            AutomationProperties.AutomationId="WipeButton"
                            Command="{x:Bind ViewModel.Privacy.RequestWipeCommand}"
                            Content="Delete everything…" />
                        <Border
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{x:Bind ViewModel.Privacy.IsConfirmingWipe, Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    AutomationProperties.AutomationId="WipeQuestion"
                                    Text="Delete every clip, board and snippet for good?"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="WipeConfirmButton"
                                        Command="{x:Bind ViewModel.Privacy.ConfirmWipeCommand}"
                                        Content="Yes, delete everything"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        AutomationProperties.AutomationId="WipeCancelButton"
                                        Command="{x:Bind ViewModel.Privacy.CancelWipeCommand}"
                                        Content="Keep my clips" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock
                            AutomationProperties.AutomationId="WipeStatus"
                            Text="{x:Bind ViewModel.Privacy.WipeStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Paste -->
            <ScrollViewer
                x:Name="PastePanel"
                AutomationProperties.AutomationId="PastePanel"
                Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Paste" />

                    <ToggleSwitch
                        AutomationProperties.AutomationId="RestoreClipboardSwitch"
                        Header="Put my clipboard back after a paste"
                        IsOn="{x:Bind ViewModel.Paste.RestorePreviousClipboard, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />

                    <ToggleSwitch
                        AutomationProperties.AutomationId="KeepCopiesSwitch"
                        Header="Also keep each copy as its own clip while collecting"
                        IsOn="{x:Bind ViewModel.Paste.KeepCopiesWhileCollecting, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />

                    <ComboBox
                        x:Name="SeparatorBox"
                        Width="260"
                        AutomationProperties.AutomationId="SeparatorBox"
                        Header="What goes between clips in a multi-paste"
                        SelectionChanged="SeparatorBox_SelectionChanged" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="CustomSeparatorBox"
                            AutomationProperties.AutomationId="CustomSeparatorBox"
                            Header="Or type your own, for example \t for a tab"
                            KeyDown="CustomSeparatorBox_KeyDown"
                            MaxLength="80" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="ApplyCustomSeparatorButton"
                            Click="ApplyCustomSeparator_Click"
                            Content="Use it" />
                    </Grid>

                    <TextBlock
                        AutomationProperties.AutomationId="PasteError"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.Paste.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- Snippets -->
            <Grid
                x:Name="SnippetsPanel"
                AutomationProperties.AutomationId="SnippetsPanel"
                ColumnSpacing="16"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView
                        x:Name="SnippetNames"
                        Grid.Row="0"
                        AutomationProperties.AutomationId="SnippetNames"
                        AutomationProperties.Name="Snippets"
                        ItemsSource="{x:Bind ViewModel.Snippets.Items}"
                        SelectedIndex="{x:Bind ViewModel.Snippets.SelectedIndex, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="snippets:SnippetListItem">
                                <TextBlock
                                    Padding="0,6"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="NewSnippetButton"
                        Command="{x:Bind ViewModel.Snippets.NewCommand}"
                        Content="New snippet"
                        ToolTipService.ToolTip="Start a new snippet (Ctrl+N)" />
                </Grid>

                <Grid Grid.Column="1" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="NameBox"
                        Grid.Row="0"
                        AutomationProperties.AutomationId="SnippetNameBox"
                        AutomationProperties.Name="Name"
                        Header="Name"
                        IsEnabled="{x:Bind ViewModel.Snippets.CanEdit, Mode=OneWay}"
                        MaxLength="64"
                        Text="{x:Bind ViewModel.Snippets.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
                        x:Name="BodyBox"
                        Grid.Row="1"
                        MinHeight="160"
                        AcceptsReturn="True"
                        AutomationProperties.AutomationId="SnippetBodyBox"
                        AutomationProperties.Name="Text"
                        FontFamily="Consolas"
                        Header="Text"
                        IsEnabled="{x:Bind ViewModel.Snippets.CanEdit, Mode=OneWay}"
                        IsSpellCheckEnabled="False"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Text="{x:Bind ViewModel.Snippets.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind local:SettingsWindow.SnippetHelp}"
                        TextWrapping="Wrap" />

                    <ItemsControl
                        Grid.Row="3"
                        AutomationProperties.AutomationId="SnippetWarnings"
                        AutomationProperties.Name="Problems in the text"
                        IsTabStop="False"
                        ItemsSource="{x:Bind ViewModel.Snippets.Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border
                        Grid.Row="4"
                        MinHeight="48"
                        MaxHeight="120"
                        Padding="10,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Preview, with a stand-in for each value" />
                            <TextBlock
                                AutomationProperties.AutomationId="SnippetPreview"
                                AutomationProperties.Name="Preview"
                                MaxLines="4"
                                Text="{x:Bind ViewModel.Snippets.Preview, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="5" Spacing="6">
                        <TextBlock
                            AutomationProperties.AutomationId="SnippetEditorError"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Snippets.ErrorMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                AutomationProperties.AutomationId="SaveSnippetButton"
                                Command="{x:Bind ViewModel.Snippets.SaveCommand}"
                                Content="Save"
                                IsEnabled="{x:Bind ViewModel.Snippets.IsDirty, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Save (Ctrl+S)" />
                            <Button
                                AutomationProperties.AutomationId="DiscardSnippetButton"
                                Command="{x:Bind ViewModel.Snippets.DiscardCommand}"
                                Content="Discard changes"
                                IsEnabled="{x:Bind ViewModel.Snippets.IsDirty, Mode=OneWay}" />
                            <Button
                                AutomationProperties.AutomationId="DeleteSnippetButton"
                                Command="{x:Bind ViewModel.Snippets.DeleteCommand}"
                                Content="Delete"
                                IsEnabled="{x:Bind ViewModel.Snippets.HasSelection, Mode=OneWay}"
                                ToolTipService.ToolTip="Delete the snippet (Ctrl+Delete)" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.Snippets.IsConfirmingDelete, Mode=OneWay}">
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="DeleteSnippetQuestion"
                                Text="{x:Bind ViewModel.Snippets.DeleteQuestion, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                AutomationProperties.AutomationId="KeepSnippetButton"
                                Command="{x:Bind ViewModel.Snippets.CancelDeleteCommand}"
                                Content="Keep it" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- About -->
            <ScrollViewer
                x:Name="AboutPanel"
                AutomationProperties.AutomationId="AboutPanel"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="About" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind prefs:AboutViewModel.Title}" />
                    <TextBlock
                        AutomationProperties.AutomationId="AboutVersion"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.About.Version}" />
                    <TextBlock
                        AutomationProperties.AutomationId="AboutLicense"
                        Text="{x:Bind prefs:AboutViewModel.License}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        AutomationProperties.AutomationId="AboutNoNetwork"
                        Text="{x:Bind prefs:AboutViewModel.NoNetworkPromise}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Padding="0"
                        AutomationProperties.AutomationId="AboutRepository"
                        Command="{x:Bind ViewModel.About.OpenRepositoryCommand}"
                        Content="{x:Bind prefs:AboutViewModel.RepositoryUrl}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
