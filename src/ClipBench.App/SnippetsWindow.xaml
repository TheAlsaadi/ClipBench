<Window
    x:Class="ClipBench.App.SnippetsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClipBench.App"
    xmlns:snippets="using:ClipBench.Presentation.Snippets"
    Title="ClipBench snippets">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Frame"
        Padding="16"
        ColumnSpacing="16"
        PreviewKeyDown="Frame_PreviewKeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView
                x:Name="SnippetNames"
                Grid.Row="0"
                AutomationProperties.AutomationId="SnippetNames"
                AutomationProperties.Name="Snippets"
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="snippets:SnippetListItem">
                        <TextBlock
                            Padding="0,6"
                            AutomationProperties.Name="{x:Bind Name}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="NewSnippetButton"
                Command="{x:Bind ViewModel.NewCommand}"
                Content="New snippet"
                ToolTipService.ToolTip="Start a new snippet (Ctrl+N)" />
        </Grid>

        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="NameBox"
                Grid.Row="0"
                AutomationProperties.AutomationId="SnippetNameBox"
                AutomationProperties.Name="Name"
                Header="Name"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                MaxLength="64"
                Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox
                x:Name="BodyBox"
                Grid.Row="1"
                MinHeight="160"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="SnippetBodyBox"
                AutomationProperties.Name="Text"
                FontFamily="Consolas"
                Header="Text"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                IsSpellCheckEnabled="False"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind ViewModel.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind local:SnippetsWindow.Help}"
                TextWrapping="Wrap" />

            <ItemsControl
                Grid.Row="3"
                AutomationProperties.AutomationId="SnippetWarnings"
                AutomationProperties.Name="Problems in the text"
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border
                Grid.Row="4"
                MinHeight="48"
                MaxHeight="120"
                Padding="10,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Preview, with a stand-in for each value" />
                    <TextBlock
                        AutomationProperties.AutomationId="SnippetPreview"
                        AutomationProperties.Name="Preview"
                        MaxLines="4"
                        Text="{x:Bind ViewModel.Preview, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="5" Spacing="6">
                <TextBlock
                    AutomationProperties.AutomationId="SnippetEditorError"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.AutomationId="SaveSnippetButton"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Content="Save"
                        IsEnabled="{x:Bind ViewModel.IsDirty, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Save (Ctrl+S)" />
                    <Button
                        AutomationProperties.AutomationId="DiscardSnippetButton"
                        Command="{x:Bind ViewModel.DiscardCommand}"
                        Content="Discard changes"
                        IsEnabled="{x:Bind ViewModel.IsDirty, Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="DeleteSnippetButton"
                        Command="{x:Bind ViewModel.DeleteCommand}"
                        Content="Delete"
                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                        ToolTipService.ToolTip="Delete the snippet (Ctrl+Delete)" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsConfirmingDelete, Mode=OneWay}">
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="DeleteSnippetQuestion"
                        Text="{x:Bind ViewModel.DeleteQuestion, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        AutomationProperties.AutomationId="KeepSnippetButton"
                        Command="{x:Bind ViewModel.CancelDeleteCommand}"
                        Content="Keep it" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
