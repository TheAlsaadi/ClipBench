<Window
    x:Class="ClipBench.App.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClipBench.App"
    xmlns:rows="using:ClipBench.Presentation.Rows"
    Title="ClipBench">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        Padding="8"
        RowSpacing="6"
        PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="0"
            AutomationProperties.AutomationId="SearchBox"
            AutomationProperties.Name="Search clips"
            PlaceholderText="Search clips"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <ListView
            x:Name="ClipList"
            Grid.Row="1"
            AutomationProperties.AutomationId="ClipList"
            AutomationProperties.Name="Clipboard history"
            IsItemClickEnabled="True"
            IsTabStop="False"
            ItemClick="ClipList_ItemClick"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="rows:ClipRowViewModel">
                    <Grid
                        Padding="2,6"
                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                        ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            FontSize="16"
                            Glyph="{x:Bind local:Glyphs.For(Format)}" />

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                MaxLines="2"
                                Text="{x:Bind DisplayText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <Image
                                MaxHeight="64"
                                HorizontalAlignment="Left"
                                Source="{x:Bind local:Glyphs.ThumbnailOf(ImagePng)}"
                                Visibility="{x:Bind HasImage}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Details}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Border
                                MinWidth="20"
                                Height="20"
                                Padding="5,0"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="10"
                                Visibility="{x:Bind HasMarkNumber, Mode=OneWay}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind MarkNumber, Mode=OneWay}" />
                            </Border>
                            <FontIcon
                                FontSize="12"
                                Glyph="&#xE718;"
                                Visibility="{x:Bind IsPinned}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="1"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" />

        <StackPanel Grid.Row="2" Spacing="2">
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.AutomationId="StatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</Window>
