      "Read(./**/*.key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git config user.*)",
      "Bash(git config --global *)",
      "Bash(git config --system *)",
      "Bash(rm -rf *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git commit --no-verify *)",
      "PowerShell(git commit -n *)",
      "PowerShell(git config user.*)",
      "PowerShell(git config --global *)",
      "PowerShell(git config --system *)",
      "PowerShell(Remove-Item * -Recurse *)"
